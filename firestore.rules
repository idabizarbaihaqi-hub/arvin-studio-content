rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if current user is owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if current user is Super Admin
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'id.abizarbaihaqi@gmail.com') ||
        request.auth.token.superAdmin == true ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN')
      );
    }

    // Match users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      // Regular user creates as USER + FREE + INACTIVE; Primary Super Admin registers as SUPER_ADMIN
      allow create: if isOwner(userId) && (
        (request.auth.token.email == 'id.abizarbaihaqi@gmail.com' && request.resource.data.role == 'SUPER_ADMIN') ||
        (request.resource.data.role == 'USER' && request.resource.data.plan == 'FREE' && request.resource.data.subscriptionStatus == 'INACTIVE')
      );
      // Super Admin can update user (e.g. approve subscription, adjust plan/credits); user can only update own profile fields
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.plan == resource.data.plan &&
        request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
      );
      // Primary Super Admin cannot be deleted
      allow delete: if isSuperAdmin() && resource.data.email != 'id.abizarbaihaqi@gmail.com';
    }

    // Match credit_transactions collection
    match /credit_transactions/{txId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isOwner(request.resource.data.userId) || isSuperAdmin();
      allow update, delete: if false; // Credit ledger entries are immutable
    }

    // Match ai_usage collection (tracked per userId_feature_date)
    match /ai_usage/{usageId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isSuperAdmin());
      allow update: if isSuperAdmin() || (
        isAuthenticated() && request.resource.data.userId == request.auth.uid &&
        (resource == null || resource.data.userId == request.auth.uid)
      );
      allow delete: if isSuperAdmin();
    }

    // Match subscriptions collection
    match /subscriptions/{subId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      // User can create subscription with PENDING_PAYMENT or PAYMENT_SUBMITTED; Super admin can create
      allow create: if isOwner(request.resource.data.userId) || isSuperAdmin();
      // Super Admin can approve/reject; user can only upload payment proof
      allow update: if isSuperAdmin() || (
        isOwner(resource.data.userId) &&
        isOwner(request.resource.data.userId) &&
        (request.resource.data.status == 'PAYMENT_SUBMITTED' || request.resource.data.status == resource.data.status)
      );
      allow delete: if isSuperAdmin();
    }

    // Match ai_history collection
    match /ai_history/{historyId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isOwner(request.resource.data.userId) || isSuperAdmin();
      allow update, delete: if isOwner(resource.data.userId) || isSuperAdmin();
    }

    // Match content_plans collection
    match /content_plans/{planId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isOwner(request.resource.data.userId) || isSuperAdmin();
      allow update: if (isOwner(resource.data.userId) && isOwner(request.resource.data.userId)) || isSuperAdmin();
      allow delete: if isOwner(resource.data.userId) || isSuperAdmin();
    }

    // Match admin_activity_logs collection
    match /admin_activity_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }

    // Match payment_accounts collection
    match /payment_accounts/{accountId} {
      // Allow read publicly for checkout/transfer instructions; write restricted to Super Admin
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Match system_settings collection (Super Admin global config, e.g. Gemini AI Key)
    match /system_settings/{settingId} {
      allow read, write: if isSuperAdmin();
    }

    // Deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
